generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Papéis de acesso da plataforma BION
// PACIENTE | MEDICO | ADMIN (string — SQLite não suporta enum nativo)

model User {
  id             String   @id @default(cuid())
  /// ID do usuário no Supabase Auth (auth.users.id). Nulo = conta legada só Prisma.
  supabaseId     String?  @unique
  nome           String
  email          String   @unique
  senhaHash      String
  role           String   @default("PACIENTE") // PACIENTE | MEDICO | ADMIN
  status         String   @default("ativo") // ativo | inativo | suspenso
  // V4: contas criadas pela administração nascem com senha padrão — troca
  // obrigatória no primeiro acesso (liberada após POST /api/auth/senha).
  precisaTrocarSenha Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessoes              Sessao[]
  perfilMedico         PerfilMedico?
  perfilPaciente       PerfilPaciente?
  consultasComoPaciente Consulta[]     @relation("ConsultaPaciente")
  consultasComoMedico  Consulta[]     @relation("ConsultaMedico")
  documentosEmitidos   Documento[]    @relation("DocumentoMedico")
  documentosRecebidos  Documento[]    @relation("DocumentoPaciente")
  arquivos             Arquivo[]      @relation("ArquivoUsuario")
  arquivosRecebidos    Arquivo[]      @relation("ArquivoPaciente")
  notificacoes         Notificacao[]
  avaliacoes           Avaliacao[]    @relation("AvaliacaoPaciente")
  avaliacoesRecebidas  Avaliacao[]    @relation("AvaliacaoMedico")
  tickets              Ticket[]
  lembretes            Lembrete[]
  consentimentos       Consentimento[]
  auditLogs            AuditLog[]
  mensagensEnviadas    Mensagem[]     @relation("MensagemDe")
  mensagensRecebidas   Mensagem[]     @relation("MensagemPara")
  medicoes             Medicao[]
  examesLaboratoriais  ExameLaboratorial[]
  anamneses            Anamnese[]
  leiturasNotificacao  NotificacaoLeitura[]
  repasses             Repasse[]      @relation("RepasseMedico")
  repassesPagos        Repasse[]      @relation("RepassePagoPor")
  repasseAjustes       RepasseAjuste[] @relation("RepasseAjusteMedico")
  dadosRecebimento     DadosRecebimentoMedico?
  bloqueiosAgenda      BloqueioAgenda[] @relation("BloqueioMedico")
  chamadasRecebidas    ChamadaConsulta[] @relation("ChamadaPara") // Admin: toque da consulta
  pushInscricoes       PushInscricao[]   // Admin: toque da consulta
  // Teleconsulta v2 — Pacientes
  medicamentosEmUso          MedicamentoEmUso[] @relation("MedicamentoEmUsoPaciente")
  medicamentosPrescritos     MedicamentoEmUso[] @relation("MedicamentoEmUsoMedico")
  pedidosMedicaoRecebidos    PedidoMedicao[]    @relation("PedidoMedicaoPaciente")
  pedidosMedicaoFeitos       PedidoMedicao[]    @relation("PedidoMedicaoMedico")
  // Teleconsulta v2 — Médicos: renovação de receita
  pedidosRenovacaoFeitos     PedidoRenovacao[]  @relation("PedidoRenovacaoPaciente")
  pedidosRenovacaoRecebidos  PedidoRenovacao[]  @relation("PedidoRenovacaoMedico")
  evolucoesComoMedico        Evolucao[]         @relation("EvolucaoMedico")
  evolucoesComoPaciente      Evolucao[]         @relation("EvolucaoPaciente")
}

model Sessao {
  id        String   @id // token opaco (32 bytes hex)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PerfilMedico {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  crm                 String
  especialidade       String
  subespecialidades   String  @default("[]") // JSON string[]
  valor               Float   @default(150) // valor da consulta em reais
  avaliacao           Float   @default(0)
  numAvaliacoes       Int     @default(0)
  formacao            String  @default("")
  experiencia         String  @default("")
  idiomas             String  @default("[]") // JSON string[]
  bio                 String  @default("")
  foto                String?
  status              String  @default("ativo") // ativo | pendente | suspenso
  stripeAccountId     String? // conta conectada (Stripe Connect), 20261028a
  horariosDisponiveis String  @default("[]") // JSON string[]
  diasAtendimento     String  @default("[]") // JSON number[] (0=Dom … 6=Sáb). Vazio = todos os dias.
  pausasSemanais      String  @default("[]") // JSON {dia,inicio,fim}[].
  // Dados pessoais do médico (privados: só o próprio médico lê/edita em
  // /api/medico/perfil — NUNCA entram no diretório público / medicoWire).
  // Migração: supabase/migrations/20261002_perfil_medico_dados_pessoais.sql
  dataNascimento      DateTime? @db.Date
  genero              String? // Feminino | Masculino | Outro | Prefiro não informar (CHECK no banco)
  telefone            String  @default("")
  cnpj                String  @default("") // 14 caracteres normalizados (numérico ou alfanumérico); "" = não informado
}

model PerfilPaciente {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cpf            String  @default("")
  telefone       String  @default("")
  convenio       String  @default("Particular")
  idade          Int     @default(0) // legado: só para quem ainda não informou dataNascimento
  dataNascimento DateTime? @db.Date
  genero         String  @default("")
  alergias       String  @default("[]") // JSON string[]
  medicamentos   String  @default("[]") // JSON string[]
  tipoSanguineo  String  @default("")
  peso           String?
  altura         String?
  profissao      String  @default("")
  estadoCivil    String  @default("")
  comorbidades   String  @default("[]") // JSON string[]
  foto           String? // data URL (avatar do app do paciente)
}

// Histórico de medidas do paciente (app imersivo, seção 2).
// tipo: "peso" (valor1 = kg) | "altura" (valor1 = cm) | "pa" (valor1 = sistólica, valor2 = diastólica)
model Medicao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      String
  valor1    Float
  valor2    Float?
  criadoEm  DateTime @default(now())
  // Teleconsulta v2 — Pacientes (migração 20261018c): de onde veio a medida.
  // origem: paciente | pedido | medico. consultaId sem FK (Consulta é do Médicos).
  origem     String         @default("paciente")
  consultaId String?
  pedidoId   String?
  pedido     PedidoMedicao? @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  @@index([usuarioId, tipo, criadoEm])
  @@index([pedidoId])
  @@index([consultaId])
}

// Resultados de exames laboratoriais extraídos de laudos enviados à BION IA
// (PDF ou foto, com verificação do nome completo do paciente no documento).
// itens: JSON [{ nome, valor, unidade, refMin, refMax }]
model ExameLaboratorial {
  id          String   @id @default(cuid())
  usuarioId   String
  usuario     User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo      String // ex.: "Hemograma completo", "Glicemia em jejum"
  dataColeta  DateTime
  itens       String   @default("[]")
  arquivoNome String?
  origem      String   @default("bion-ia") // bion-ia | manual
  createdAt   DateTime @default(now())

  @@index([usuarioId, dataColeta])
}

model Consulta {
  id                 String   @id @default(cuid())
  pacienteId         String
  paciente           User     @relation("ConsultaPaciente", fields: [pacienteId], references: [id], onDelete: Cascade)
  medicoId           String
  medico             User     @relation("ConsultaMedico", fields: [medicoId], references: [id], onDelete: Restrict)
  especialidade      String
  dataInicio         DateTime
  status             String   @default("confirmada") // confirmada | em_espera | pendente_anamnese (legado) | aguardando_reagendamento | cancelada | concluida
  motivoConsulta     String?
  motivoCancelamento String?
  resumoMedico       String?
  valor              Float    @default(0) // reais
  pago               Boolean  @default(false)
  remarcada          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Teleconsulta v2: tipo do atendimento e consulta de origem (renovação,
  // retorno, segunda opinião). Trava no banco: Consulta_tipoAtendimento_check.
  tipoAtendimento    String    @default("padrao") // padrao | renovacao | retorno | segunda_opiniao
  // consultaOrigemId nunca é o próprio id (Consulta_origem_diferente_check)
  retornoSugeridoEm  DateTime? @db.Timestamptz(3) // data de retorno sugerida pelo médico
  documentos         Documento[] @relation("DocumentoConsulta")
  consultaOrigemId   String?
  consultaOrigem     Consulta? @relation("ConsultaOrigem", fields: [consultaOrigemId], references: [id], onDelete: SetNull)
  consultasDerivadas Consulta[] @relation("ConsultaOrigem")
  renovacoesDaOrigem PedidoRenovacao[] @relation("PedidoRenovacaoOrigem")
  renovacoesChamada  PedidoRenovacao[] @relation("PedidoRenovacaoChamada")

  // Telemedicina WebRTC (Fase 2)
  sinaisSala    SinalSala[]
  chatGuardado  ChatConsulta[]
  presencasSala PresencaSala[]

  // Anamnese conduzida pela BION IA (uma por consulta)
  anamnese Anamnese?

  // Pagamento (confirmado pelo servidor/gateway — nunca pelo cliente)
  pagamento Pagamento?

  // Fase financeira: histórico de cancelamentos/remarcações e repasse
  eventos     EventoConsulta[]
  repasseItens RepasseItem[]
  repasseAjustes RepasseAjuste[]
  remarcacoes RemarcacaoPendente[]
  chamadas    ChamadaConsulta[] // Admin: toque da consulta
  evolucao    Evolucao?         // Teleconsulta v2 — Médicos: evolução (1 por consulta)
  esperaMedico   EsperaMedico?  @relation("EsperaConsulta") // Admin: espera do médico
  esperasOrigem  EsperaMedico[] @relation("EsperaConsultaNova")

  @@unique([id, medicoId]) // alvo das FKs (consultaId, medicoId) do repasse
  @@index([consultaOrigemId])
}

// Cobrança da consulta. O CLIENTE NUNCA define `pago` — a confirmação vem do
// servidor: webhook do gateway (assinado com HMAC) ou gateway simulado em
// demonstração. status: pendente | confirmado | falhou.
model Pagamento {
  id           String    @id @default(cuid())
  consultaId   String?   @unique // nulo só na renovação por mensagem: aí o vínculo é PedidoRenovacao.pagamentoId (20261020b)
  consulta     Consulta? @relation(fields: [consultaId], references: [id], onDelete: Cascade)
  valor        Float
  metodo       String    @default("pix") // pix | cartao
  status       String    @default("pendente") // pendente | confirmado | falhou
  via          String    @default("webhook") // webhook | simulado
  gatewayRef   String?
  criadoEm     DateTime  @default(now())
  confirmadoEm DateTime?
  // Stripe (migração 20261028a). Gravados pelo webhook do checkout.
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeChargeId          String?
  stripeTaxaCentavos      Int? // taxa real cobrada pelo Stripe (balance_transaction.fee)

  reembolsos Reembolso[]
  pedidoRenovacao PedidoRenovacao? @relation("PedidoRenovacaoPagamento")
}

// Triagem (anamnese) guiada pela BION IA em formato storytelling, feita APÓS o
// pagamento. O pagamento CONFIRMA a consulta; a triagem é obrigatória e fica
// disponível da confirmação ATÉ 5 MINUTOS ANTES do horário da consulta (janela
// imposta pelo servidor em /api/anamnese) e NÃO altera o status.
// coleta: JSON com os dados organizados por etapa (identificação,
// queixa, HDA, sistemas, antecedentes, família, hábitos, gineco, psicossocial,
// medicamentos). documentos: JSON [{ nome, tipo, exameImportado, resumo }].
model Anamnese {
  id         String   @id @default(cuid())
  consultaId String   @unique
  consulta   Consulta @relation(fields: [consultaId], references: [id], onDelete: Cascade)
  usuarioId  String
  usuario    User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  etapa      String   @default("identificacao")
  status     String   @default("em_andamento") // em_andamento | concluida
  coleta     String   @default("{}")
  documentos String   @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([usuarioId, status])
}

// Mensagens de sinalização WebRTC trocadas entre paciente e médico durante a teleconsulta.
// Cada linha carrega um SDP (oferta/resposta), um ICE candidate, uma mensagem de chat
// ou um sinal de controle (ex.: "outro lado encerrou"). Consumido = já entregue ao destinatário.
model SinalSala {
  id          String   @id @default(cuid())
  consultaId  String
  consulta    Consulta @relation(fields: [consultaId], references: [id], onDelete: Cascade)
  deUsuarioId String
  deRole      String // PACIENTE | MEDICO
  tipo        String // oferta | resposta | candidato | chat | controle
  payload     String // JSON (SDP, candidate, {texto}, {acao})
  createdAt   DateTime @default(now())
  consumido   Boolean  @default(false)

  @@index([consultaId, consumido, createdAt])
}

// Chat da teleconsulta guardado com a consulta (decisão do Alisson, 20/10/2026:
// faz parte do prontuário, CFM 20 anos; nunca é apagado pela limpeza da sala).
// Cópia das linhas tipo "chat" da SinalSala (lib/server/chat-consulta.ts);
// sinalId = id do sinal original (UNIQUE: copiar duas vezes não duplica).
// Só o médico e o paciente da consulta leem (lib/chat-consulta-acesso.ts);
// o admin nunca recebe o conteúdo.
model ChatConsulta {
  id         String   @id @default(cuid())
  sinalId    String   @unique
  consultaId String
  consulta   Consulta @relation(fields: [consultaId], references: [id], onDelete: Restrict)
  autorId    String
  papel      String // PACIENTE | MEDICO
  texto      String
  criadoEm   DateTime

  @@index([consultaId, criadoEm])
}

// Presença em tempo real na sala: heartbeat a cada ciclo de polling (~1,5s).
// Considera-se online quem fez ping nos últimos 12 segundos.
model PresencaSala {
  consultaId String
  consulta   Consulta @relation(fields: [consultaId], references: [id], onDelete: Cascade)
  usuarioId  String
  papel      String // PACIENTE | MEDICO
  ultimoPing DateTime @default(now())
  /// Entrada da sessão ATUAL na sala: zera (vira o instante da volta) quando o
  /// sinal fica mais de 30 s parado. Prova de quanto tempo a pessoa esperou
  /// (falta do paciente). Nula nas linhas anteriores à migração 20261006b.
  entrouEm   DateTime?

  @@id([consultaId, usuarioId])
}

// Mensageria assíncrona paciente ↔ médico (e suporte BION) entre as consultas.
// "lida" controla o badge de não lidas por conversa (marcada quando o destinatário abre).
model Mensagem {
  id        String   @id @default(cuid())
  deId      String
  de        User     @relation("MensagemDe", fields: [deId], references: [id], onDelete: Cascade)
  paraId    String
  para      User     @relation("MensagemPara", fields: [paraId], references: [id], onDelete: Cascade)
  texto     String
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())
  // Permite polling incremental: o cliente busca apenas mensagens novas ou
  // com recibo de leitura atualizado desde a última varredura.
  updatedAt DateTime @default(now()) @updatedAt

  @@index([deId, paraId, createdAt])
  @@index([paraId, lida])
  @@index([updatedAt])
}

model Documento {
  id          String   @id @default(cuid())
  tipo        String // receita | atestado | exame_solicitado
  titulo      String
  conteudo    String
  medicoId    String
  medico      User     @relation("DocumentoMedico", fields: [medicoId], references: [id], onDelete: Restrict)
  pacienteId  String
  paciente    User     @relation("DocumentoPaciente", fields: [pacienteId], references: [id], onDelete: Cascade)
  medicamento String?
  posologia   String?
  duracao     String?
  observacoes String?
  cid         String?
  createdAt   DateTime @default(now())
  renovacoesPedidas   PedidoRenovacao[] @relation("PedidoRenovacaoDocumento")
  renovacoesEmitidas  PedidoRenovacao[] @relation("PedidoRenovacaoDocumentoNovo")
  // Teleconsulta v2 — Médicos
  controlado  Boolean   @default(false) // receita de controlado (fica fora da renovação curta)
  consultaId  String?   // consulta em que o documento foi emitido
  consulta    Consulta? @relation("DocumentoConsulta", fields: [consultaId], references: [id], onDelete: SetNull)

  @@index([consultaId])
}

model Arquivo {
  id          String   @id @default(cuid())
  nome        String
  tipo        String
  tamanhoKb   Int
  enviadoPor  String // paciente | medico
  /// Quem ENVIOU o arquivo (paciente ou médico).
  usuarioId   String
  usuario     User     @relation("ArquivoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  /// Paciente a quem o arquivo pertence/destina (A3). Upload de paciente = ele
  /// mesmo; upload de médico = paciente com quem o médico tem consulta.
  /// Nulo = legado sem destinatário identificável (só o remetente/admin veem).
  /// Migração: supabase/migrations/20260930_arquivo_paciente_id.sql
  pacienteId  String?
  paciente    User?    @relation("ArquivoPaciente", fields: [pacienteId], references: [id], onDelete: SetNull)
  consulta    String   @default("")
  /// Path no bucket Supabase Storage (documentos), se houver upload real
  storagePath String?
  createdAt   DateTime @default(now())

  @@index([pacienteId])
}

model Notificacao {
  id        String   @id @default(cuid())
  usuarioId String?
  usuario   User?    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  paraRole  String? // broadcast por papel: PACIENTE | MEDICO | ADMIN
  tipo      String // lembrete | mensagem | receita | agenda | exame | suporte
  titulo    String
  texto     String
  // "lida" é estado PRIVADO para notificações dirigidas (usuarioId preenchido).
  // Em broadcasts (usuarioId nulo) a linha é COMPARTILHADA — o estado de
  // leitura por usuário vive em NotificacaoLeitura (V7), então marcar como
  // lida não apaga o badge dos demais destinatários.
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())
  leituras  NotificacaoLeitura[]
}

// V7 — leitura POR USUÁRIO de notificações de broadcast (usuarioId nulo).
// Linha única compartilhada com "lida" global fazia um destinatário apagar
// o badge de todos os demais.
model NotificacaoLeitura {
  id            String      @id @default(cuid())
  notificacaoId String
  notificacao   Notificacao @relation(fields: [notificacaoId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuario       User        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  lidaEm        DateTime    @default(now())

  @@unique([notificacaoId, usuarioId])
  @@index([usuarioId])
}

model Avaliacao {
  id            String   @id @default(cuid())
  consultaId    String?
  pacienteId    String
  paciente      User     @relation("AvaliacaoPaciente", fields: [pacienteId], references: [id], onDelete: Cascade)
  medicoId      String
  medico        User     @relation("AvaliacaoMedico", fields: [medicoId], references: [id], onDelete: Cascade)
  nota          Int // 1-5
  comentario    String?
  pontualidade  Int?
  atencao       Int?
  clareza       Int?
  createdAt     DateTime @default(now())
}

model Ticket {
  id            String   @id @default(cuid())
  usuarioId     String
  usuario       User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  perfil        String // paciente | medico
  assunto       String
  categoria     String // tecnico | pagamento | agendamento | outro
  mensagem      String
  status        String   @default("aberto") // aberto | em_andamento | resolvido
  resposta      String?
  respondidoPor String?
  dataResposta  DateTime?
  createdAt     DateTime @default(now())
}

model Lembrete {
  id          String  @id @default(cuid())
  usuarioId   String
  usuario     User    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  titulo      String
  horario     String
  tipo        String // Medicação | Consulta | Exame | Hidratação
  frequencia  String
  feito       Boolean @default(false)
  medicamento String?
  // Teleconsulta v2 — Pacientes (migração 20261018c). origem: paciente | receita | medico.
  // documentoId sem FK (Documento é do Médicos).
  origem             String            @default("paciente")
  medicamentoEmUsoId String?
  medicamentoEmUso   MedicamentoEmUso? @relation(fields: [medicamentoEmUsoId], references: [id], onDelete: SetNull)
  documentoId        String?

  @@index([medicamentoEmUsoId])
}

model Consentimento {
  id          String   @id @default(cuid())
  pacienteId  String?
  paciente    User?    @relation(fields: [pacienteId], references: [id], onDelete: SetNull)
  quem        String // nome de quem registrou
  perfil      String // papel de quem registrou
  finalidade  String
  documentos  Int      @default(0)
  aceito      Boolean
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  acao       String
  categoria  String // autenticacao | consulta | documento | prontuario | usuario | admin | suporte | consentimento | sistema
  severidade String   @default("info") // info | warning | critical
  usuarioId  String?
  usuario    User?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioNome String
  role       String
  entidade   String?
  entidadeId String?
  detalhes   String?
  createdAt  DateTime @default(now())
}

// Cofre de identificação (LGPD art. 16, I + Lei 13.787/2018): identificação
// mínima (nome, CPF, data de nascimento) do paciente ANONIMIZADO, cifrada com
// AES-256-GCM (chave BION_COFRE_CHAVE, só no servidor), para reidentificar o
// prontuário preservado por obrigação legal. Busca exata por HMAC-SHA256.
// `userId` é String simples SEM @relation de propósito (não altera o model User).
model IdentificacaoCofre {
  id            String   @id @default(cuid())
  userId        String   @unique // id do User (paciente) anonimizado
  dadosCifrados String // "v1:iv:tag:ciphertext" (base64)
  cpfHash       String? // HMAC-SHA256 do CPF só com dígitos
  nomeHash      String? // HMAC-SHA256 do nome sem acento, minúsculo
  createdAt     DateTime @default(now())

  @@index([cpfHash])
  @@index([nomeHash])
}

// =====================================================================
// Fase financeira (regras em src/lib/server/financeiro.ts)
// Valores novos em CENTAVOS (Int). `valor Float` antigo segue como está e é
// convertido na leitura. Todas as tabelas: RLS ligado, sem policies e sem
// grants (só o servidor, via Prisma, lê e grava).
// =====================================================================

// Histórico imutável de mudanças da consulta. Gravado SÓ pelo servidor, na
// MESMA transação da alteração da Consulta.
// tipo: cancelada | remarcada | falha_tecnica | falta_paciente
// por: paciente | medico | sistema | admin
// motivo: pedido_paciente | agenda_cancelada | falha_tecnica | admin | reagendamento | falta_paciente
// dataAnterior: data/hora que estava marcada ANTES da mudança (base da multa).
model EventoConsulta {
  id            String    @id @default(cuid())
  consultaId    String
  consulta      Consulta  @relation(fields: [consultaId], references: [id], onDelete: Cascade)
  tipo          String
  por           String
  atorId        String?
  em            DateTime  @default(now())
  dataAnterior  DateTime
  dataNova      DateTime?
  motivo        String
  multaCentavos Int?
  /// Correção pelo admin (migração 20261006d): o evento fica no histórico,
  /// mas deixa de valer como desfecho. As três juntas ou nenhuma.
  corrigidoEm    DateTime?
  corrigidoPorId String?
  motivoCorrecao String?

  @@index([consultaId, em])
  @@index([dataAnterior])
  @@index([em])
}

// Devolução (total ou parcial) de um Pagamento da consulta OU da multa paga
// numa RemarcacaoPendente que não pôde ser aplicada (exatamente um dos dois).
// status: em_analise | solicitado | aprovado | processado | negado | falhou
// origem: automatico (regras de cancelamento) | manual (paciente pede pelo
// suporte numa falta; começa em em_analise e o admin aprova ou nega).
// Só UM reembolso ATIVO (em_analise | solicitado | aprovado | processado) por pagamento:
// garantido no servidor e por índice único parcial na migração SQL.
model Reembolso {
  id            String              @id @default(cuid())
  pagamentoId   String?
  pagamento     Pagamento?          @relation(fields: [pagamentoId], references: [id], onDelete: Cascade)
  remarcacaoId  String?             @unique
  remarcacao    RemarcacaoPendente? @relation(fields: [remarcacaoId], references: [id], onDelete: Cascade)
  valorCentavos Int
  multaCentavos Int       @default(0)
  motivo        String
  status        String    @default("solicitado")
  gatewayRef    String?
  solicitadoPor String
  criadoEm      DateTime  @default(now())
  processadoEm  DateTime?
  origem        String    @default("automatico")
  justificativa String?
  respostaAdmin String?
  decididoPor   String?
  decididoEm    DateTime?
  repasseAjuste RepasseAjuste?
  stripeRefundId String? @unique // preenchido = enviado ao Stripe (20261028a)

  @@index([pagamentoId, status])
  @@index([status, criadoEm])
  @@index([origem, status, criadoEm])
}

// Repasse DIÁRIO ao médico. Só existe a partir do fechamento (23:30 de São
// Paulo, consultas do dia): não há linha "aberta"; a prévia é calculada na hora.
// competencia: "AAAA-MM-DD" (dia em São Paulo; CHECK no banco, data real).
// status: fechado | pago. Pago exige pagoEm, pagoPorId, comprovante e a cópia
// completa da chave PIX (pix*: trocar a chave depois não muda o histórico).
// Fórmula (CHECK no banco; nada negativo):
//   liquido = bruto − comissao − taxas − reembolsos + multas − ajustes
//   comissao = 10% só do bruto; taxas = gateway (0 até informar);
//   reembolsos = parte do médico em reembolsos ANTES do fechamento;
//   multas = parte do médico (50%) no dia em que a multa foi paga;
//   ajustes = soma de RepasseAjuste.valorAplicadoCentavos.
// Migração: supabase/migrations/20261003_repasse_diario.sql. NUNCA vai ao
// paciente (fora do consultaWire, medicoWire e bootstrap).
model Repasse {
  id                  String          @id @default(cuid())
  medicoId            String
  medico              User            @relation("RepasseMedico", fields: [medicoId], references: [id], onDelete: Restrict)
  competencia         String
  brutoCentavos       Int             @default(0)
  comissaoCentavos    Int             @default(0)
  taxasCentavos       Int             @default(0)
  reembolsosCentavos  Int             @default(0)
  multasCentavos      Int             @default(0)
  ajustesCentavos     Int             @default(0)
  liquidoCentavos     Int             @default(0)
  status              String          @default("fechado")
  criadoEm            DateTime        @default(now())
  fechadoEm           DateTime        @default(now())
  pagoEm              DateTime?
  pagoPorId           String?
  pagoPor             User?           @relation("RepassePagoPor", fields: [pagoPorId], references: [id], onDelete: Restrict)
  comprovantePath     String? // caminho no bucket PRIVADO (nunca URL pública)
  pixTipo             String?
  pixChave            String?
  pixTitularNome      String?
  pixTitularDocumento String?
  itens               RepasseItem[]
  ajustes             RepasseAjuste[]

  @@unique([medicoId, competencia])
  @@unique([id, medicoId]) // alvo das FKs compostas de item/ajuste
  @@index([competencia, status])
}

// Item do repasse: a consulta OU a parte do médico numa multa.
// tipo: consulta | multa_cancelamento | multa_remarcacao (bruto = comissão = 0
// nas multas). chave (montada pelo servidor, conferida por CHECK):
//   "consulta:<consultaId>" | "multa_cancelamento:<consultaId>" |
//   "multa_remarcacao:<remarcacaoId>" → cada coisa entra uma vez só.
// (repasseId, medicoId) → Repasse(id, medicoId): não cai no repasse de outro.
// (consultaId, medicoId) → Consulta(id, medicoId): a consulta é do mesmo
//   médico (trocar o médico de consulta já repassada fica bloqueado).
// (remarcacaoId, consultaId) → RemarcacaoPendente(id, consultaId): a multa é
//   de uma remarcação da MESMA consulta.
// liquido = bruto − comissao − taxas − reembolsos + multas (CHECK).
model RepasseItem {
  id                 String              @id @default(cuid())
  repasseId          String
  medicoId           String
  repasse            Repasse             @relation(fields: [repasseId, medicoId], references: [id, medicoId], onDelete: Restrict)
  tipo               String
  chave              String              @unique
  consultaId         String? // nulo só no item 'renovacao' (RepasseItem_alvo_check: exatamente um entre consultaId e pedidoRenovacaoId)
  consulta           Consulta?           @relation(fields: [consultaId, medicoId], references: [id, medicoId], onDelete: Restrict, onUpdate: Restrict)
  pedidoRenovacaoId  String?             @unique
  pedidoRenovacao    PedidoRenovacao?    @relation(fields: [pedidoRenovacaoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  remarcacaoId       String?             @unique
  remarcacao         RemarcacaoPendente? @relation(fields: [remarcacaoId, consultaId], references: [id, consultaId], onDelete: Restrict, onUpdate: Restrict)
  brutoCentavos      Int
  comissaoCentavos   Int                 @default(0)
  taxasCentavos      Int                 @default(0)
  reembolsosCentavos Int                 @default(0)
  multasCentavos     Int                 @default(0)
  liquidoCentavos    Int
  criadoEm           DateTime            @default(now())

  @@index([repasseId])
  @@index([consultaId])
}

// Desconto num repasse SEGUINTE.
// motivo "reembolso": reembolso efetivado depois de a consulta/multa ter
//   entrado num repasse fechado (reembolsoId e consultaId obrigatórios;
//   reembolsoId único: desconta uma vez só).
// motivo "saldo_anterior": resto de um ajuste aplicado em parte
//   (origemAjusteId único; consulta opcional).
// Pendente: repasseId/aplicadoEm nulos e valorAplicado = 0. Aplicado:
//   0 < valorAplicado ≤ valor; se menor, o resto vira um "saldo_anterior".
// (repasseId, medicoId) → Repasse(id, medicoId): não cai no repasse de outro.
// (consultaId, medicoId) → Consulta(id, medicoId) e (origemAjusteId, medicoId)
//   → RepasseAjuste(id, medicoId): consulta e sobra são do mesmo médico.
model RepasseAjuste {
  id                    String         @id @default(cuid())
  medicoId              String
  medico                User           @relation("RepasseAjusteMedico", fields: [medicoId], references: [id], onDelete: Restrict)
  consultaId            String?
  consulta              Consulta?      @relation(fields: [consultaId, medicoId], references: [id, medicoId], onDelete: Restrict, onUpdate: Restrict)
  motivo                String // reembolso | saldo_anterior
  reembolsoId           String?        @unique
  reembolso             Reembolso?     @relation(fields: [reembolsoId], references: [id], onDelete: Restrict)
  origemAjusteId        String?        @unique
  origemAjuste          RepasseAjuste? @relation("AjusteSaldo", fields: [origemAjusteId, medicoId], references: [id, medicoId], onDelete: Restrict, onUpdate: Restrict)
  saldos                RepasseAjuste[] @relation("AjusteSaldo") // no máximo 1 (origemAjusteId @unique)
  valorCentavos         Int // parte do MÉDICO a descontar (> 0)
  valorAplicadoCentavos Int            @default(0)
  repasseId             String?
  repasse               Repasse?       @relation(fields: [repasseId, medicoId], references: [id, medicoId], onDelete: Restrict)
  criadoEm              DateTime       @default(now())
  aplicadoEm            DateTime?

  @@unique([id, medicoId]) // alvo da FK (origemAjusteId, medicoId): a sobra fica com o mesmo médico
  @@index([medicoId, repasseId])
  @@index([repasseId])
}

// Chave PIX do médico (privada: só o próprio médico e o admin). O titular é o
// próprio médico (pf, CPF) ou o CNPJ do PerfilMedico (pj; conferido no
// servidor). titularDocumento normalizado: 11 dígitos (CPF) ou 14 (CNPJ).
model DadosRecebimentoMedico {
  id               String   @id @default(cuid())
  medicoId         String   @unique
  medico           User     @relation(fields: [medicoId], references: [id], onDelete: Cascade)
  pixTipo          String // cpf | cnpj | email | telefone | aleatoria
  pixChave         String
  titularTipo      String // pf | pj
  titularNome      String
  titularDocumento String
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @default(now()) @updatedAt
}

// Remarcação do PACIENTE com multa (≤24 h da data de referência): a nova data
// fica RESERVADA até a multa ser paga. Aprovada → a consulta muda de data (na
// mesma transação, com EventoConsulta). Falhou/expirou/cancelada → a consulta
// fica na data original. Expiração verificada na leitura (expiraEm < agora).
// A cobrança da multa vive aqui (o Pagamento é 1:1 com a consulta).
// status: pendente | aprovada | expirada | falhou | cancelada
// Só UMA pendente por consulta (índice único parcial na migração SQL).
model RemarcacaoPendente {
  id            String     @id @default(cuid())
  consultaId    String
  consulta      Consulta   @relation(fields: [consultaId], references: [id], onDelete: Cascade)
  novaData      DateTime
  multaCentavos Int
  status        String     @default("pendente")
  metodo        String     @default("pix") // pix | cartao
  via           String?    // webhook | simulado
  gatewayRef    String?
  solicitadoPor String
  expiraEm      DateTime
  criadoEm      DateTime   @default(now())
  aprovadoEm    DateTime?
  reembolso     Reembolso?
  repasseItens  RepasseItem[] // no máximo 1 (remarcacaoId @unique)

  @@unique([id, consultaId]) // alvo da FK (remarcacaoId, consultaId) do RepasseItem
  @@index([consultaId, status])
  @@index([novaData, status])
}

// Dia inteiro bloqueado pelo médico (folga/férias): pacientes não agendam nem
// remarcam para esse dia. `dia` = dia civil em America/Sao_Paulo (DATE; o
// Prisma lê/grava como meia-noite UTC). `motivo` é PRIVADO do médico — nunca
// vai ao paciente. Migração: supabase/migrations/20261002b_bloqueio_agenda.sql
model BloqueioAgenda {
  id       String   @id @default(cuid())
  medicoId String
  medico   User     @relation("BloqueioMedico", fields: [medicoId], references: [id], onDelete: Cascade)
  dia      DateTime @db.Date
  motivo   String   @default("")
  criadoEm DateTime @default(now())

  @@unique([medicoId, dia])
  @@index([dia])
}

// Admin: toque da consulta (PR 1 do plano teleconsulta-v2 — só schema).
// Relações com ON DELETE CASCADE, iguais às FKs da migração
// supabase/migrations/20261018a_chamada_push.sql (assim um `prisma db push`
// não apaga as FKs).

// Registro de cada toque: uma linha por consulta, usuário e tentativa.
model ChamadaConsulta {
  id            String    @id @default(cuid())
  consultaId    String
  tentativa     Int                   // 1..3
  paraUsuarioId String                // quem recebeu o toque
  papel         String                // paciente | medico
  status        String    @default("tocando") // tocando | atendida | recusada | expirada
  tocouEm       DateTime  @default(now())
  expiraEm      DateTime              // tocouEm + 2 min
  respondidaEm  DateTime?
  canal         String    @default("realtime") // realtime | push | reenvio | ambos | sem_inscricao
  pushEnviado   Boolean   @default(false)

  consulta      Consulta  @relation(fields: [consultaId], references: [id], onDelete: Cascade)
  paraUsuario   User      @relation("ChamadaPara", fields: [paraUsuarioId], references: [id], onDelete: Cascade)

  @@unique([consultaId, paraUsuarioId, tentativa]) // trava contra toque duplo
  @@index([status, expiraEm])
  @@index([paraUsuarioId])
}

// Inscrições de Web Push (uma por aparelho/navegador).
model PushInscricao {
  id          String    @id @default(cuid())
  usuarioId   String
  endpoint    String    @unique
  p256dh      String
  auth        String
  plataforma  String?             // ios_pwa | android | desktop
  userAgent   String?
  criadaEm    DateTime  @default(now())
  ultimoUsoEm DateTime?
  falhas      Int       @default(0) // 404/410 do serviço de push → apagar

  usuario     User      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

// =====================================================================
// Teleconsulta v2 — Pacientes
// Migração: supabase/migrations/20261018c_medicamentos_pedido_medicao.sql
// RLS ligado, sem policies e sem grants (só o servidor, via Prisma, lê e grava).
// consultaId/documentoId são String simples SEM @relation de propósito: não
// alteram Consulta nem Documento (donos: Médicos). Integridade no servidor.
// =====================================================================

// Medicamento em uso do paciente (estruturado). Substitui aos poucos o JSON
// livre PerfilPaciente.medicamentos. Uma receita (Documento) pode gerar vários.
// posologia: JSON { vezesAoDia, horarios: ["08:00", ...], dias, textoLivre? }
// origem: paciente | receita | medico. controlado: não aparece "Renovar receita".
model MedicamentoEmUso {
  id           String    @id @default(cuid())
  pacienteId   String
  paciente     User      @relation("MedicamentoEmUsoPaciente", fields: [pacienteId], references: [id], onDelete: Cascade)
  nome         String
  dose         String?
  via          String?
  posologia    String    @default("{}")
  usoContinuo  Boolean   @default(false)
  controlado   Boolean   @default(false)
  inicio       DateTime  @default(now())
  fim          DateTime?
  ativo        Boolean   @default(true)
  origem       String    @default("paciente")
  documentoId  String?
  consultaId   String?
  medicoId     String?
  medico       User?     @relation("MedicamentoEmUsoMedico", fields: [medicoId], references: [id], onDelete: SetNull)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @default(now()) @updatedAt
  lembretes    Lembrete[]

  @@index([pacienteId, ativo])
  @@index([documentoId])
  @@index([medicoId])
}

// Pedido do médico para o paciente informar medidas ("pedir levantamento").
// tipos: JSON string[] com peso | altura | pressao. status: pendente | atendido | cancelado.
model PedidoMedicao {
  id         String    @id @default(cuid())
  consultaId String?
  pacienteId String
  paciente   User      @relation("PedidoMedicaoPaciente", fields: [pacienteId], references: [id], onDelete: Cascade)
  medicoId   String
  medico     User      @relation("PedidoMedicaoMedico", fields: [medicoId], references: [id], onDelete: Cascade)
  tipos      String    @default("[]")
  status     String    @default("pendente") // pendente | atendido | cancelado (PedidoMedicao_status_check)
  criadoEm   DateTime  @default(now())
  atendidoEm DateTime?
  medicoes   Medicao[]

  @@index([pacienteId, status])
  @@index([consultaId])
  @@index([medicoId])
}

// Teleconsulta v2 — Médicos: pedido de renovação de receita feito pelo
// paciente. Trava no banco: PedidoRenovacao_status_check.
model PedidoRenovacao {
  id                 String     @id @default(cuid())
  pacienteId         String
  paciente           User       @relation("PedidoRenovacaoPaciente", fields: [pacienteId], references: [id], onDelete: Cascade)
  medicoId           String
  medico             User       @relation("PedidoRenovacaoMedico", fields: [medicoId], references: [id], onDelete: Restrict)
  consultaOrigemId   String?
  consultaOrigem     Consulta?  @relation("PedidoRenovacaoOrigem", fields: [consultaOrigemId], references: [id], onDelete: SetNull)
  documentoId        String?    // receita anterior que o paciente quer renovar
  documento          Documento? @relation("PedidoRenovacaoDocumento", fields: [documentoId], references: [id], onDelete: SetNull)
  documentoNovoId    String?    // receita nova, quando status = renovada
  documentoNovo      Documento? @relation("PedidoRenovacaoDocumentoNovo", fields: [documentoNovoId], references: [id], onDelete: SetNull)
  status             String     @default("pendente") // aguardando_pagamento | pendente | renovada | chamada_marcada | recusada | cancelado; respondidoEm nulo só nos abertos (aguardando_pagamento, pendente) — PedidoRenovacao_respondido_check
  valorCentavos      Int?       // valor normal da consulta do médico, copiado no pedido (20261020a)
  pagamentoId        String?    @unique
  pagamento          Pagamento? @relation("PedidoRenovacaoPagamento", fields: [pagamentoId], references: [id], onDelete: SetNull)
  observacaoPaciente String?
  mensagemMedico     String?
  consultaId         String?    // chamada curta marcada pelo médico
  consulta           Consulta?  @relation("PedidoRenovacaoChamada", fields: [consultaId], references: [id], onDelete: SetNull)
  criadoEm           DateTime   @default(now()) @db.Timestamptz(3)
  respondidoEm       DateTime?  @db.Timestamptz(3)

  repasseItens       RepasseItem[] // no máximo 1 (pedidoRenovacaoId @unique), item tipo renovacao (20261020b)

  @@index([medicoId, status, criadoEm])
  @@index([pacienteId])
  @@index([consultaOrigemId])
  // Índice único parcial só no SQL (o Prisma não suporta parcial):
  // "PedidoRenovacao_aberto_unico" (pacienteId, documentoId) WHERE status IN ('aguardando_pagamento','pendente')
  // — um só pedido aberto por paciente e receita. Ver 20261020a.
  // Também só no SQL: "PedidoRenovacao_pendente_criadoEm_idx" (criadoEm) WHERE status = 'pendente'.
}

// Teleconsulta v2 — Médicos: evolução do médico (1 por consulta). Seções em
// JSON (string). status: rascunho | concluida (Evolucao_status_check). Enquanto
// o médico tiver evolução em rascunho, não inicia outra consulta (trava).
model Evolucao {
  id           String    @id @default(cuid())
  consultaId   String    @unique
  consulta     Consulta  @relation(fields: [consultaId], references: [id], onDelete: Cascade)
  medicoId     String
  medico       User      @relation("EvolucaoMedico", fields: [medicoId], references: [id], onDelete: Restrict)
  pacienteId   String
  paciente     User      @relation("EvolucaoPaciente", fields: [pacienteId], references: [id], onDelete: Cascade)
  dados        String    @default("{}")
  triagem      String    @default("{}")
  exames       String    @default("{}")
  medicamentos String    @default("{}")
  conduta      String    @default("{}")
  cid          String?
  documentos   String    @default("[]")
  rascunho     String    @default("{}") // estado livre do autosave da tela
  status       String    @default("rascunho") // rascunho | concluida
  criadoEm     DateTime  @default(now()) @db.Timestamptz(3)
  concluidaEm  DateTime? @db.Timestamptz(3)
  atualizadoEm DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([medicoId, status])
  @@index([pacienteId])
}

// Admin: espera do médico (paciente na sala, médico ainda não entrou).
// Migração: supabase/migrations/20261019c_espera_medico.sql (CHECKs, índice
// parcial em expiraEm WHERE status='aguardando', RLS). Uma por consulta.
// status: aguardando | medico_entrou | expirada | remarcando | cancelada | remarcada.
// remarcando: esperando o pagamento da diferença até reservaExpiraEm (10 min).
// diferencaCentavos = valorNovo − valorAntigo (> 0 paciente paga; < 0 recebe).
model EsperaMedico {
  id                  String    @id @default(cuid())
  consultaId          String    @unique
  consulta            Consulta  @relation("EsperaConsulta", fields: [consultaId], references: [id], onDelete: Cascade)
  iniciadaEm          DateTime
  expiraEm            DateTime
  status              String    @default("aguardando")
  consultaNovaId      String?
  consultaNova        Consulta? @relation("EsperaConsultaNova", fields: [consultaNovaId], references: [id], onDelete: SetNull)
  valorAntigoCentavos Int?
  valorNovoCentavos   Int?
  diferencaCentavos   Int?
  reembolsoId         String?
  reservaExpiraEm     DateTime?
  criadoEm            DateTime  @default(now())
  resolvidoEm         DateTime?

  @@index([consultaNovaId])
  @@index([status, resolvidoEm])
}

// Idempotência do webhook Stripe (20261028a). id = event.id.
model StripeEvento {
  id           String    @id
  tipo         String
  recebidoEm   DateTime  @default(now())
  processadoEm DateTime?

  @@index([tipo, recebidoEm])
}
