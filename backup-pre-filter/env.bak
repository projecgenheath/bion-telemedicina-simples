# BION Telemedicina — ambiente LOCAL DE TESTE (sandbox)
# O projeto oficial usa PostgreSQL (Supabase) — ver .env.example.
# Aqui usamos SQLite apenas para rodar/testar sem credenciais externas.
DATABASE_URL="file:../db/bion-local.db"

# IA generativa: força o canal SDK do sandbox (z-ai-web-dev-sdk, backend-only)
BION_LLM_FORCAR_SDK="1"

# Pagamentos: sem segredo de webhook => gateway SIMULADO confirma no servidor (demo)
