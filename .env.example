# ===============================================================
# BION Telemedicina — variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# O arquivo .env NUNCA deve ser commitado no git.
# ===============================================================

# ---- Banco de dados (Supabase Postgres via Session Pooler) ----
# Project Settings → Database → Connection string → Session pooler
# Substitua <REGIAO>, <REF_DO_PROJETO> e <SUA_SENHA>.
# Exemplo: postgresql://postgres.abc123:xYz@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.<REF_DO_PROJETO>:<SUA_SENHA>@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres?sslmode=require"

# O banco é PostgreSQL (Supabase) em TODOS os ambientes — não há mais fallback SQLite.
#
# DATABASE_URL="postgresql://postgres.<REF>:<SENHA>@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres?sslmode=require"

# ---- Supabase (chaves públicas — seguras no navegador) ----
NEXT_PUBLIC_SUPABASE_URL="https://<REF_DO_PROJETO>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# ---- IA generativa da BION IA (cadeia: 0 → 1 → 2 → 3) ----
# 0) GOOGLE GEMINI (canal preferencial quando a chave estiver configurada).
#    Canal confiável: dados completos, sem anonimização, aceita foto e PDF de laudo.
#    Defina BION_LLM_GEMINI_API_KEY na Vercel (Settings → Environment Variables)
#    e/ou no .env local. A chave NUNCA vai no código (repo público).
# BION_LLM_GEMINI="0"                       # desliga o canal Gemini
# BION_LLM_GEMINI_API_KEY="AQ.Ab8..."       # chave da Google AI Studio / GCP
# BION_LLM_GEMINI_MODEL="gemini-flash-latest"
#
# 1) API PRÓPRIA GENÉRICA (canal confiável — dados completos, sem anonimização):
#    qualquer endpoint compatível com OpenAI (chat/completions).
#    Exemplos: https://api.openai.com/v1 · https://api.z.ai/api/paas/v4 · https://api.groq.com/openai/v1
# BION_LLM_BASE_URL="https://api.openai.com/v1"
# BION_LLM_API_KEY="sk-..."
# BION_LLM_MODEL="gpt-4o-mini"
#
# 2) ENDPOINT PÚBLICO SEM CHAVE (reserva — funciona na Vercel sem config).
#    Por LGPD, nomes do paciente/médico são ANONIMIZADOS nas mensagens antes do envio.
#    Modelo real servido no tier anônimo: gpt-oss (NÃO é um Gemma) — para
#    qualidade superior configure os canais 0 ou 1 acima; o servidor anyway
#    impõe o rito da triagem (pergunta única, ponte de etapa, sem beco sem saída).
# BION_LLM_PUBLICO="0"                      # desliga o canal público (padrão: ativo)
# BION_LLM_PUBLICO_URL="https://text.pollinations.ai/openai"
# BION_LLM_PUBLICO_MODEL="openai-fast"      # alternativas: openai, mistral
#
# 3) SDK do sandbox (z-ai-web-dev-sdk) — só existe na rede interna; usado como
#    último recurso e em desenvolvimento local.
# BION_LLM_FORCAR_SDK="1"                   # força o SDK e ignora os canais gemini/público
#
# Sem nenhum canal disponível, os motores locais determinísticos assumem
# (anamnese guiada + respostas por intenção) — a BION IA nunca fica muda.
# BION_MOTOR_LOCAL="1"                      # força os motores locais (teste)

# ---- Telemedicina (WebRTC) — TURN para travessia de NAT (item 9) ----
# A lista de ICE servers é montada NO SERVIDOR e entregue apenas aos
# participantes da sala (GET /api/telemedicina/[id]/sala → iceServers) —
# credenciais NUNCA ficam no bundle do cliente.
# STUN público (Google) é sempre incluído. Para TURN em produção, configure:
# BION_TURN_URLS="turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp"
# BION_TURN_USERNAME="..."
# BION_TURN_CREDENTIAL="..."
# Provedores com free tier: Metered (CA Standard), Cloudflare Calls TURN, Xirsys,
# Twilio NTS — ou coturn próprio (VM barata). URLs separadas por vírgula.
# Sem a variável, entra a reserva OpenRelay (comunidade, gratuita): o navegador
# só a aciona quando o caminho direto/STUN falha (NAT simétrico, CGNAT,
# firewall corporativo) — a chamada conecta onde antes não conectava.

# ---- Pagamentos (server-side) ----
# O cliente NUNCA define `pago`. Sem a variável abaixo, o gateway SIMULADO
# confirma a cobrança no servidor (modo demonstração). Com a variável definida,
# a confirmação só acontece via POST /api/pagamentos/webhook assinado com
# HMAC-SHA256 deste segredo no header `x-bion-signature` (gateway real).
# BION_PAGAMENTO_WEBHOOK_SECRET="um-segredo-longo-e-aleatorio"
