# ===============================================================
# BION Telemedicina — variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# O arquivo .env NUNCA deve ser commitado no git.
# ===============================================================

# ---- Banco de dados (Supabase Postgres via Session Pooler) ----
# Project Settings → Database → Connection string → Session pooler
# Substitua <REGIAO>, <REF_DO_PROJETO> e <SUA_SENHA>.
# Exemplo: postgresql://postgres.abc123:xYz@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.<REF_DO_PROJETO>:<SUA_SENHA>@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres?sslmode=require"

# Para desenvolvimento local sem Supabase, use SQLite:
# DATABASE_URL="file:./db/custom.db"

# ---- Supabase (chaves públicas — seguras no navegador) ----
NEXT_PUBLIC_SUPABASE_URL="https://<REF_DO_PROJETO>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
